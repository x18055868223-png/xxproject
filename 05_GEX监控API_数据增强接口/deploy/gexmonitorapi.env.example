# 复制到 /etc/gexmonitorapi.env，改掉 API_TOKEN，然后 chmod 600。
# systemd EnvironmentFile 格式：每行 KEY=VALUE，不要加引号、不要写 export。

# 强 Token：ssh 到服务器后用 `python3 -c "import secrets;print(secrets.token_urlsafe(32))"` 生成
API_TOKEN=REPLACE_WITH_A_STRONG_RANDOM_TOKEN

# true = GET /v1/info 无需 token 直接可读（POST /v1/refresh 仍需 token）。
# 仅在服务绑定 127.0.0.1 时开启；绑定 0.0.0.0 对公网开放时保持 false。
PUBLIC_READ=false

# 数据源：public_json 使用公开 JSON 接口；page 仅用于回滚旧页面抓取。
GEXMONITOR_SOURCE_MODE=public_json
GEXMONITOR_OPTIONS_CHAIN_CROSSCHECK=true

# 15 分钟一次：须小于 FMZ space_gate_net_gamma_fresh_ms(20 分钟) 减上游延迟，否则 SpaceGate 周期性失效
REFRESH_INTERVAL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=45

# 缓存持久化到 app 目录下（确保运行用户对该目录可写）
CACHE_FILE=/home/ubuntu/gexmonitorapi/.cache/cache.json

# rank 历史持久化；每次全量刷新追加一行，rank 默认只用最近 30 天窗口
HISTORY_FILE=/home/ubuntu/gexmonitorapi/.cache/metrics_history.jsonl
RANK_LOOKBACK_DAYS=30

USER_AGENT=gexmonitorapi/0.2.1 (+https://gexmonitor.com public JSON metric monitor)

# 后台周期刷新：开。启动后台任务会立刻先抓一轮，再按间隔循环。
ENABLE_BACKGROUND_REFRESH=true
# 启动时阻塞式抓一轮：建议关，避免拖慢服务就绪（后台任务无论如何会立即抓一次）。
REFRESH_ON_STARTUP=false

# --- 页面回滚路径（SOURCE_MODE=page 时才使用；默认 JSON 模式不需要） ---
# 面板是 websocket 推送、DOM 加载后才渲染，固定等待这么多毫秒再取文本。
BROWSER_WAIT_MS=12000
# 锁死 user namespace 的主机上 headless Chromium 起不来时设 true（见故障排查 解法 B）
BROWSER_NO_SANDBOX=false
# dashboard 需登录时，指向运行用户可读的 Playwright storage_state JSON。
# BROWSER_STORAGE_STATE_FILE=/home/ubuntu/gexmonitorapi/.cache/storage_state.json
# 同一轮 all refresh 复用一次渲染文本，避免连续拉起四个 Chromium。
BROWSER_TEXT_CACHE_SECONDS=60
