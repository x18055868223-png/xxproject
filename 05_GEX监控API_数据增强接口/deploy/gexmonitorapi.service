[Unit]
Description=gexmonitorapi (BTC GEX Monitor metric API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/gexmonitorapi
# Secrets/config live here (root-owned, chmod 600). See gexmonitorapi.env.example
EnvironmentFile=/etc/gexmonitorapi.env
Environment=PYTHONUNBUFFERED=1
# Bind to 0.0.0.0 for direct exposure (open port 8000 in the Lightsail firewall).
# If you put Nginx in front, change --host to 127.0.0.1 instead.
ExecStart=/home/ubuntu/gexmonitorapi/.venv/bin/python -m uvicorn gexmonitorapi.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
# Public JSON mode performs low-frequency HTTP reads; keep a generous startup window
# for DNS/TLS and optional first-refresh retries.
TimeoutStartSec=90

# --- memory containment (CRITICAL on small shared boxes) ---
# Bounds the blast radius so a co-located FMZ service cannot be starved. JSON
# mode should stay well below these limits; they also protect the explicit page
# rollback path if it is temporarily enabled.
MemoryHigh=450M
MemoryMax=600M
MemorySwapMax=512M

# --- light hardening (kept loose so the headless browser can launch) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
