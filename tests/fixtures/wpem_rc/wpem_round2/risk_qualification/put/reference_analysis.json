        "file_sha256": "1ec1be066103c4f70d1e632d05b484f0f938781e9fb91d1a9ba013ab01997a0c",
        "source_definition": "def payout(side,short,long,settlement):\n    if settlement<=0:raise ValueError('invalid settlement')\n    if side=='put':return (max(short-settlement,0)-max(long-settlement,0))/settlement\n    if side=='call':return (max(settlement-short,0)-max(settlement-long,0))/settlement\n    raise ValueError('invalid side')",
        "source_definition_sha256": "8fc892d138ea76ed5b386f252454185a2ac158f5bfc1f1e8c80704e03e92eebf",
        "start_line": 117,
        "symbol": "payout"
      },
