# GFRI v1.1 Shadow Collector Configuration (DEFAULT OFF)
# All operational execution flags MUST remain off/SHADOW_ONLY in v1.1.

GFRI_COLLECTOR_ENABLED=0
GFRI_DECISION_AUTHORITY=SHADOW_ONLY
GFRI_PLAYER_INTEGRATION_ENABLED=0
GFRI_LIVE_VETO_ENABLED=0

# Storage outside repository working tree
GFRI_STATE_DIR=/opt/gfri-shadow/state
GFRI_RAW_CAPTURE_DIR=/opt/gfri-shadow/raw_captures
GFRI_INCLUDE_OKX_REF=1

# Confirmation timing (3 pre-freeze OB samples spaced 20s apart)
GFRI_CONFIRM_SAMPLES=3
GFRI_CONFIRM_INTERVAL_SEC=20
GFRI_OB_SKEW_MAX_MS=900000
GFRI_SOURCE_AGE_MAX_MS=3600000
