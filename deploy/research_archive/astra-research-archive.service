[Unit]
Description=xxproject research archive tick (frozen cases, ledger, inquirer, outcomes; docs/opus/08)
After=network-online.target astra-workbench-v20.service

[Service]
Type=oneshot
User=bitnami
Group=research
UMask=0027
EnvironmentFile=/etc/signal-audit/llm.env
EnvironmentFile=/etc/signal-audit/workbench-v20.env
Environment=ASTRA_RESEARCH_ARCHIVE=/var/lib/xxproject/research_archive
ExecStart=/usr/bin/python3 /opt/signal-audit-tools/astra_research_archive_v1.py tick
TimeoutStartSec=1800
Nice=10
