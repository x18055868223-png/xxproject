{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xxproject/astra_inquiry_result@0.1",
  "title": "astra_inquiry_result@0.1 — archived inquirer output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "case_id",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "astra_inquiry_result@0.1"
    },
    "case_id": {
      "type": "string"
    },
    "asof_ms": {
      "type": [
        "integer",
        "null"
      ],
      "description": "UTC epoch milliseconds"
    },
    "prompt_version": {
      "type": "string"
    },
    "requested_model": {
      "type": "string"
    },
    "effort": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "PARTIAL",
        "REJECTED",
        "ERROR"
      ]
    },
    "attempts": {
      "type": "array"
    },
    "sheet": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "protocol",
            "case_id",
            "fact_brief",
            "questions"
          ],
          "properties": {
            "protocol": {
              "const": "inquiry_sheet@0.2"
            },
            "case_id": {
              "type": "string"
            },
            "fact_brief": {
              "type": "object",
              "required": [
                "layers"
              ],
              "properties": {
                "layers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "layer",
                      "status",
                      "facts"
                    ],
                    "properties": {
                      "layer": {
                        "pattern": "^L[0-8]$"
                      },
                      "status": {
                        "enum": [
                          "material",
                          "quiet",
                          "unknown"
                        ]
                      },
                      "facts": {
                        "type": "array"
                      }
                    }
                  }
                },
                "cross_layer": {
                  "type": "array"
                }
              }
            },
            "anomalies": {
              "type": "array"
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "id",
                  "type",
                  "bears_on",
                  "priority",
                  "premises",
                  "hypotheses",
                  "answer_source"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "conflict",
                      "collinear",
                      "temporal",
                      "gap",
                      "mechanism",
                      "compensation",
                      "scenario"
                    ]
                  },
                  "bears_on": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "touch_prob",
                        "expiry_loss_prob",
                        "tail_loss",
                        "compensation"
                      ]
                    }
                  },
                  "priority": {
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "answer_source": {
                    "enum": [
                      "case_file",
                      "history",
                      "external",
                      "unobtainable"
                    ]
                  },
                  "hypotheses": {
                    "type": "array",
                    "minItems": 2
                  },
                  "premises": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            },
            "coverage_note_cn": {
              "type": [
                "string",
                "null"
              ]
            },
            "types_covered": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "issues": {
      "type": "array"
    },
    "error": {
      "type": "string",
      "description": "exception class name when status=ERROR"
    }
  },
  "description": "inquiry/<UTC day>/<HH>_<side>_<case_id>.json = {case_id, asof_ms} merged with inquiry.run() output. On an exception the file is {case_id, asof_ms, status:'ERROR', error} with no schema field."
}
