{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xxproject/research_note@0.1",
  "title": "research_note@0.1 — free research note (inbox submission)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "agent",
    "title_cn",
    "body_cn"
  ],
  "properties": {
    "schema": {
      "const": "research_note@0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      }
    },
    "title_cn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "body_cn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000,
      "pattern": "\\S"
    }
  }
}
