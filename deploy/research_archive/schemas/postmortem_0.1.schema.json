{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xxproject/postmortem@0.1",
  "title": "postmortem@0.1 — expiry-day review (inbox submission)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "agent",
    "expiry_date",
    "findings_cn"
  ],
  "properties": {
    "schema": {
      "const": "postmortem@0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      }
    },
    "expiry_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "UTC expiry day"
    },
    "findings_cn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "inquiry_review": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "question_id",
          "verdict"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pointed_to_realized_risk",
              "not_material",
              "wrong_premise",
              "unclear"
            ]
          },
          "note_cn": {
            "type": "string"
          }
        }
      }
    }
  }
}
