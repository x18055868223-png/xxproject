# Example environment configuration for astra-execution-coordinator.service
# Copy to /etc/signal-audit/exec-coordinator.env (chmod 0600, owned root:root).
# Also provision a dedicated 32+ byte secret before running deploy_release --with-execution:
#   /etc/signal-audit/exec-control.token   (0600 root:root, admin/deploy socket auth; NEVER equals ASTRA_WORKBENCH_TOKEN)
ASTRA_EXEC_ENV_TAG=tn
# Set isolated Deribit subaccount ID/username before TESTNET or non-SHADOW_ONLY launch:
# ASTRA_EXEC_SUBACCOUNT_ID=
# Leave empty so Linux SO_PEERCRED defaults strictly to {0 (root), uid(astra-exec)} (bitnami & workbench excluded):
ASTRA_EXEC_ALLOWED_PEER_UIDS=
# Continuous capital authorization defaults strictly unarmed (0 / 0 BTC):
ASTRA_EXEC_ENTRY_ARMED=0
ASTRA_EXEC_BUDGET_CAP_BTC=0
ASTRA_EXEC_MAX_QTY_BTC=0.1
# Isolated execution subaccount credentials (NEVER store in workbench-v20.env or llm.env):
# DERIBIT_EXEC_CLIENT_ID=
# DERIBIT_EXEC_CLIENT_SECRET=
