[Unit]
Description=xxproject AI Player 5m fixed-grid checks, trigger coalescing & hold review (SHADOW_ONLY)
After=network-online.target astra-workbench-v20.service

[Service]
Type=oneshot
User=bitnami
Group=research
UMask=0027
WorkingDirectory=/opt/xxproject/current/tools
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=ASTRA_DERIBIT_COOLDOWN_FILE=/var/lib/xxproject/workbench/deribit_cooldown.json
EnvironmentFile=/etc/signal-audit/llm.env
EnvironmentFile=/etc/signal-audit/workbench-v20.env
ExecStart=/usr/bin/python3 /opt/xxproject/current/tools/astra_player_tracking_v13.py --url http://127.0.0.1:8895 sync-open --root /var/lib/xxproject/workbench/shadow_dossiers --check-due --review --archive /var/lib/xxproject/research_archive
TimeoutStartSec=900
Nice=10
