[Unit]
Description=Materialize server-native signal_review.jsonl for the static signal audit page
After=astra-signal-producer.service

[Service]
Type=oneshot
User=bitnami
Group=bitnami
WorkingDirectory=/opt/xxproject/current/tools
Environment=JSONL_SOURCE=/var/lib/xxproject/signal_native/logs/signal_review.jsonl
Environment=LLM_REVIEWS_SOURCE=/var/lib/xxproject/signal_audit/signal_llm_reviews.jsonl
Environment=TRANSITION_LEDGER_SOURCE=/var/lib/xxproject/signal_audit/signal_transition_ledger.jsonl
Environment=TRANSITION_STATE_SOURCE=/var/lib/xxproject/signal_audit/signal_transition_state.json
Environment=TRANSITION_LLM_REVIEWS_SOURCE=/var/lib/xxproject/signal_audit/signal_transition_llm_reviews.jsonl
Environment=OUTPUT_DIR=/opt/signal-audit
Environment=MAX_CARDS=15
Environment=SESSION_CONTEXT_REQUIRED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/signal-audit/signal-audit-materialize.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/signal-audit /var/lib/xxproject/signal_audit
MemoryHigh=384M
MemoryMax=512M
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300
ExecStart=/usr/bin/python3 /opt/xxproject/current/tools/materialize_signal_cards.py --source ${JSONL_SOURCE} --require-valid-source-tail --output ${OUTPUT_DIR} --max-cards ${MAX_CARDS} --llm-reviews ${LLM_REVIEWS_SOURCE} --transition-ledger ${TRANSITION_LEDGER_SOURCE} --transition-state ${TRANSITION_STATE_SOURCE} --transition-reviews ${TRANSITION_LLM_REVIEWS_SOURCE}
