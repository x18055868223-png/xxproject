[Unit]
Description=xxproject v2.6.3 private observation workbench
After=network-online.target astra-signal-producer.service
Wants=network-online.target astra-signal-producer.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=600
User=bitnami
Group=bitnami
WorkingDirectory=/opt/xxproject/current/tools
EnvironmentFile=-/etc/signal-audit/llm.env
EnvironmentFile=/etc/signal-audit/workbench-v20.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Environment=ASTRA_WORKBENCH_FRONTEND_DIR=/opt/xxproject/current/deploy/astra_workbench_v3
Environment=ASTRA_DERIBIT_COOLDOWN_FILE=/var/lib/xxproject/workbench/deribit_cooldown.json
Environment=ASTRA_AI_SHADOW_EXPERIMENT=1
Environment=ASTRA_AI_SHADOW_DOSSIER_ROOT=/var/lib/xxproject/workbench/shadow_dossiers
Environment=ASTRA_RESEARCH_MAX_BYTES=2147483648
Environment=ASTRA_RESEARCH_MAX_SAMPLES=20000
Environment=ASTRA_WORKBENCH_MEMORY_SOFT_MB=3584
Environment=ASTRA_WORKBENCH_MEMORY_HARD_MB=4608
ExecStart=/usr/bin/env ASTRA_WORKBENCH_FRONTEND_DIR=/opt/xxproject/current/deploy/astra_workbench_v3 /usr/bin/python3 /opt/xxproject/current/tools/astra_workbench_v20.py --host 127.0.0.1 --port 8895
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xxproject/workbench /var/lib/xxproject/llm
MemoryHigh=5G
MemoryMax=6G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
