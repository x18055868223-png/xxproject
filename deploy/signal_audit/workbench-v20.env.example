# Astra v2.0 local workbench template. Copy to a private environment file on the server.
ASTRA_WORKBENCH_HOST=127.0.0.1
ASTRA_WORKBENCH_PORT=8895
ASTRA_WORKBENCH_SNAPSHOTS_JSONL=/home/bitnami/fmz2/logs/storage/668422/demo/logs/snapshots.jsonl
ASTRA_WORKBENCH_STATE_DIR=/opt/signal-audit-tools/astra-workbench-v20
ASTRA_WORKBENCH_FRONTEND_DIR=/opt/signal-audit
# Public HTTPS origin for the private workbench route, for example
# https://example.com. Leave empty for loopback-only local use.
ASTRA_WORKBENCH_PUBLIC_ORIGIN=
# Server-side session cookies are only an access convenience. They never carry
# provider keys, candidate identities, or per-policy secrets in URLs or storage.
ASTRA_WORKBENCH_SESSION_TTL_SECONDS=43200
ASTRA_WORKBENCH_MAX_SESSIONS=32
ASTRA_WORKBENCH_TOKEN=
ASTRA_WORKBENCH_USAGE_LEDGER=/opt/signal-audit-tools/signal_llm_usage_ledger.json
# Default is zero model traffic. Set model/provider credentials and a positive
# daily limit only after the manual provider path is explicitly authorized.
ASTRA_WORKBENCH_LLM_MODEL=
ASTRA_WORKBENCH_DAILY_HTTP_LIMIT=0
ASTRA_WORKBENCH_REVIEW_TIMEOUT_S=180
ASTRA_WORKBENCH_REFRESH_SECONDS=30
# Explicit local RC profile. Default 0 preserves the bounded_claim_ids@2.4.7 entry.
# Set 1 only for the reviewed WPEM candidate profile; this selects 2.6.2 grounded explanations
# and does not change financial gates, account permissions, or LLM timers.
ASTRA_WORKBENCH_WPEM_ENABLED=0
# Locked references use the existing collector; GET/export never collect.
# Budgets pause sampling visibly and retain immutable baselines.
ASTRA_LOCKED_SAMPLE_INTERVAL_MS=60000
ASTRA_LOCKED_MAX_ACTIVE=4
ASTRA_LOCKED_MAX_EPISODES=64
ASTRA_LOCKED_MAX_BYTES=268435456
ASTRA_LOCKED_MAX_SAMPLES=1440
# MAP public background collectors are opt-in. GET/manual review never fetch slow sources.
ASTRA_MAP_SOURCES_ENABLED=0
# Default keeps the workbench's local collector/cache. For deployed MAP producer
# consumption, use producer_manifest with ASTRA_MAP_SOURCES_ENABLED=0.
ASTRA_MAP_SOURCE_MODE=collector
ASTRA_MAP_PRODUCER_CURRENT_PATH=/opt/astra-map-data/state/current_map.json
ASTRA_MAP_PRODUCER_MAX_AGE_MS=600000
ASTRA_MAP_KPF_SNAPSHOT_PATH=
ASTRA_MAP_KPF_AUDIT_PATH=
ASTRA_MAP_KPF_DEBUG_PATH=
# Prefer the atomic local producer manifest over three independently resolved paths.
ASTRA_MAP_KPF_MANIFEST_PATH=/opt/astra-map-data/kpf/current.json

# Optional read-only admission diagnosis for the reviewed research asset.
# Configure both files. This does not enable model inference or supply risk mu.
ASTRA_RISK_MODEL_PATH=
ASTRA_RISK_PROTOCOL_PATH=

# Optional. Without these, SpaceGate email transitions are recorded as not sent.
# LLM_API_KEY=
# LLM_BASE_URL=
# ASTRA_WORKBENCH_SMTP_HOST=
# ASTRA_WORKBENCH_SMTP_PORT=587
# ASTRA_WORKBENCH_SMTP_USERNAME=
# ASTRA_WORKBENCH_SMTP_PASSWORD=
# ASTRA_WORKBENCH_SMTP_FROM=
# ASTRA_WORKBENCH_SMTP_TO=
# ASTRA_WORKBENCH_SMTP_STARTTLS=1
