# Example nginx server block for the signal audit static frontend.
# Adjust server_name and TLS settings for the strategy server.

server {
    listen 80;
    server_name _;

    root /opt/signal-audit;
    index index.html;

    # This public HTTP example serves only the static audit surface. The
    # workbench API contains private locked-policy observations, including GET
    # projections, so every workbench API path is blocked here.
    location = /api/workbench {
        return 403;
    }

    location ^~ /api/workbench/ {
        return 403;
    }

    location /signal_cards/ {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
