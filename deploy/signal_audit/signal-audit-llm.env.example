# Local server-only config. Copy/edit as /etc/signal-audit/llm.env.
# Keep this file mode 0600 and never commit real keys.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_REVIEW_LIMIT=4
LLM_MAX_CONCURRENCY=4
LLM_DAILY_HTTP_CAP=60
LLM_RECON_EFFORT=high
LLM_RECON_TIMEOUT=240
# Existing-server v2 migration: freeze pre-rollout card IDs once in this JSON.
# Keep the file across upgrades; missing/invalid configured files stop API calls.
# Explicit isolated --only-card-id research may bypass this automatic exclusion.
# LLM_AUTOMATIC_EXCLUSIONS=/var/lib/xxproject/signal_audit/signal_review_automatic_exclusions.json
JSONL_SOURCE=/var/lib/xxproject/signal_native/logs/signal_review.jsonl
LLM_REVIEWS_SOURCE=/var/lib/xxproject/signal_audit/signal_llm_reviews.jsonl
TRANSITION_LEDGER_SOURCE=/var/lib/xxproject/signal_audit/signal_transition_ledger.jsonl
TRANSITION_LLM_REVIEWS_SOURCE=/var/lib/xxproject/signal_audit/signal_transition_llm_reviews.jsonl
