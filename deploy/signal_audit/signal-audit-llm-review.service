[Unit]
Description=Generate provider-neutral DeepSeek LLM reviews for signal audit cards
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TOOLS_ROOT=/opt/signal-audit-tools
Environment=JSONL_SOURCE=/home/bitnami/fmz2/logs/storage/668422/demo/logs/signal_review.jsonl
Environment=LLM_REVIEWS_SOURCE=/opt/signal-audit-tools/signal_llm_reviews.jsonl
Environment=TRANSITION_LEDGER_SOURCE=/opt/signal-audit-tools/signal_transition_ledger.jsonl
Environment=TRANSITION_LLM_REVIEWS_SOURCE=/opt/signal-audit-tools/signal_transition_llm_reviews.jsonl
Environment=LLM_PROVIDER=deepseek
Environment=LLM_BASE_URL=https://api.deepseek.com
Environment=LLM_MODEL=deepseek-v4-flash
Environment=LLM_REVIEW_LIMIT=4
Environment=TRANSITION_REVIEW_LIMIT=4
Environment=LLM_MAX_CONCURRENCY=4
Environment=LLM_DAILY_HTTP_CAP=60
Environment=TRANSITION_BLIND_MODE=single_call_evidence_first
Environment=LLM_BLIND_EFFORT=low
Environment=LLM_RECON_EFFORT=high
Environment=LLM_TRANSITION_EFFORT=low
Environment=LLM_BLIND_TIMEOUT=60
Environment=LLM_RECON_TIMEOUT=240
Environment=LLM_TRANSITION_TIMEOUT=120
EnvironmentFile=-/etc/signal-audit/llm.env
MemoryHigh=128M
MemoryMax=256M
CPUQuota=35%
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=600
ExecStartPre=/bin/systemctl start signal-audit-materialize.service
ExecStart=/opt/signal-audit-tools/run_signal_llm_review.sh
ExecStopPost=/bin/systemctl start signal-audit-materialize.service
