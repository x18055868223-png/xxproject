{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xxproject/stage1@0.1",
  "title": "stage1@0.1 — blind read submission (manual 07 §4.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "task_id", "case_id", "agent", "submitted_at", "own_concerns", "blind_rating"],
  "properties": {
    "protocol": {"const": "stage1@0.1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "case_id": {"type": "string"},
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["name", "model"],
      "properties": {"name": {"type": "string"}, "model": {"type": "string"}}
    },
    "submitted_at": {"type": "string", "format": "date-time"},
    "own_concerns": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["text_cn", "refs", "direction"],
        "properties": {
          "text_cn": {"type": "string", "minLength": 1, "maxLength": 1200},
          "refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^L[0-9]\\."}},
          "direction": {"enum": ["riskier", "safer", "unclear"]}
        }
      }
    },
    "blind_rating": {
      "type": "object", "additionalProperties": false, "required": ["risk_vs_baseline", "grade"],
      "properties": {
        "risk_vs_baseline": {"enum": ["much_safer", "safer", "in_line", "riskier", "much_riskier"]},
        "grade": {"enum": ["A", "B", "C", "D", "E", "U"]},
        "note_cn": {"type": ["string", "null"], "maxLength": 1200}
      }
    }
  }
}
